name: Daily Nature Quran Shorts

on:
  workflow_dispatch:
  schedule:
    - cron: "15 8 * * *"
      timezone: "Asia/Dubai"

jobs:
  create-nature-shorts:
    runs-on: ubuntu-latest

    steps:

      - name: Checkout repository
        uses: actions/checkout@v6

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: Install FFmpeg and Arabic libraries
        run: |
          sudo apt-get update
          sudo apt-get install -y ffmpeg
          sudo apt-get install -y \
            libfreetype6-dev \
            libharfbuzz-dev \
            libfribidi-dev \
            libraqm-dev

      - name: Install Python packages
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Check Pexels API key
        env:
          PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
        run: |
          if [ -z "$PEXELS_API_KEY" ]; then
            echo "PEXELS_API_KEY is missing"
            exit 1
          fi

          echo "Pexels API key detected"

      - name: Check Arabic font
        run: |
          if [ ! -f "fonts/NotoNaskhArabic-Regular.otf" ]; then
            echo "Noto Naskh Arabic font is missing"
            echo "Expected:"
            echo "fonts/NotoNaskhArabic-Regular.otf"
            exit 1
          fi

          echo "Noto Naskh Arabic font detected"

      - name: Create 3 Nature Quran Shorts
        env:
          PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
        run: |
          python nature_quran_generator.py

      - name: Check generated files
        run: |
          echo "Checking output folder..."
          ls -lh output

          echo ""
          echo "Checking video 1..."
          test -f output/nature_quran_short_1.mp4

          echo "Checking video 2..."
          test -f output/nature_quran_short_2.mp4

          echo "Checking video 3..."
          test -f output/nature_quran_short_3.mp4

          echo ""
          echo "Checking metadata 1..."
          test -f output/metadata_1.txt

          echo "Checking metadata 2..."
          test -f output/metadata_2.txt

          echo "Checking metadata 3..."
          test -f output/metadata_3.txt

          echo ""
          echo "All 3 videos and metadata files exist successfully."

      - name: Show video information
        run: |
          echo "=============================="
          echo "SHORT 1"
          echo "=============================="

          ffprobe -v error \
            -show_entries format=duration,size \
            -show_entries stream=width,height,codec_name \
            -of default=noprint_wrappers=1 \
            output/nature_quran_short_1.mp4

          echo ""
          echo "=============================="
          echo "SHORT 2"
          echo "=============================="

          ffprobe -v error \
            -show_entries format=duration,size \
            -show_entries stream=width,height,codec_name \
            -of default=noprint_wrappers=1 \
            output/nature_quran_short_2.mp4

          echo ""
          echo "=============================="
          echo "SHORT 3"
          echo "=============================="

          ffprobe -v error \
            -show_entries format=duration,size \
            -show_entries stream=width,height,codec_name \
            -of default=noprint_wrappers=1 \
            output/nature_quran_short_3.mp4

      - name: Upload 3 Nature Quran Shorts
        uses: actions/upload-artifact@v4
        with:
          name: nature-quran-shorts-${{ github.run_number }}
          path: output/
          retention-days: 7
